{
  "name": "hglobal-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "H-Global1985 central member system (id.hglobal1985.com)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "tsx scripts/generate-openapi.mjs",
    "openapi:check": "tsx scripts/generate-openapi.mjs --check",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "policy:check": "node scripts/check-repo-policy.mjs",
    "ci": "npm run policy:check && npm run secrets:scan && npm run typecheck && npm run lint && npm test && npm run openapi:check",
    "dev": "wrangler dev --env staging"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
