{
  // Worker for id.hglobal1985.com. No account_id here: this repo is public.
  // The account is selected by CLOUDFLARE_ACCOUNT_ID in GitHub Actions Secrets at deploy time.
  // Secrets (never in this file), per environment: GOOGLE_CLIENT_SECRET, OIDC_SIGNING_JWK, optional OIDC_SIGNING_JWK_PREVIOUS.
  "name": "hglobal-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "env": {
    "staging": {
      "name": "hglobal-id-staging",
      // Served at the workers.dev address; the issuer falls back to the request origin outside production.
      // GOOGLE_CLIENT_ID is added once the owner creates the H-Global1985 Google OAuth client.
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        { "binding": "DB", "database_name": "hglobal-id-staging", "database_id": "dd723fe4-afa0-4748-96eb-a57cb66b414c", "migrations_dir": "migrations" }
      ],
      // Workers Rate Limiting (per member): reads 120/min, writes 30/min.
      "unsafe": {
        "bindings": [
          { "name": "RL_READ", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
          { "name": "RL_WRITE", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
        ]
      },
      "triggers": { "crons": ["0 19 * * *"] }
    },
    "production": {
      "name": "hglobal-id",
      // GOOGLE_CLIENT_ID is added here once the owner creates the H-Global1985 Google OAuth client.
      "vars": { "ENVIRONMENT": "production", "ISSUER": "https://id.hglobal1985.com" },
      // Production database created 2026-11-10 (APAC) with the owner's approval.
      "d1_databases": [
        { "binding": "DB", "database_name": "hglobal-id", "database_id": "c0c3f5bf-5641-4d08-b170-4243c76cc72e", "migrations_dir": "migrations" }
      ],
      // Workers Rate Limiting (per member): reads 120/min, writes 30/min.
      "unsafe": {
        "bindings": [
          { "name": "RL_READ", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
          { "name": "RL_WRITE", "type": "ratelimit", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
        ]
      },
      "triggers": { "crons": ["0 19 * * *"] }
    }
  }
}
